{
  "name": "@panelvm/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "create-admin": "tsx --env-file-if-exists=../../.env src/scripts/create-admin.ts",
    "db:backup": "tsx --env-file-if-exists=../../.env src/scripts/backup-db.ts",
    "rotate-key": "tsx --env-file-if-exists=../../.env src/scripts/rotate-key.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "otplib": "^13.5.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
