# Salin ke .env lalu isi. JANGAN commit .env. Nilai di bawah untuk produksi; untuk dev pakai NODE_ENV=development, APP_ORIGIN=http://localhost:5173, TRUST_PROXY=false.
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://vm.thegt.my.id
DATABASE_PATH=/var/lib/panel/panel.db
# 32 byte, base64. Contoh membuat: openssl rand -base64 32
SECRETS_MASTER_KEY=
# Acak panjang, minimal 32 karakter. Contoh: openssl rand -base64 48
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TRUST_PROXY=true
# Retensi audit log (hari) dan batas upload (MB). Opsional.
AUDIT_RETENTION_DAYS=90
MAX_UPLOAD_MB=512
# Pemeriksaan status VM tiap N detik (0 = nonaktif).
VM_CHECK_INTERVAL_SEC=60
# HANYA untuk uji lewat IP lokal tanpa HTTPS (APP_ORIGIN harus http://...). Cookie tidak aman. JANGAN dipakai bila terbuka ke internet.
# INSECURE_HTTP=true
