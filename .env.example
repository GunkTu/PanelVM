# Salin ke .env lalu isi. JANGAN commit .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/panel.db
# 32 byte, base64. Contoh membuat: openssl rand -base64 32
SECRETS_MASTER_KEY=
# Acak panjang, minimal 32 karakter. Contoh: openssl rand -base64 48
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TRUST_PROXY=false
